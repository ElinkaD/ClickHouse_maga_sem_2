{
  "info": {
    "name": "Energosbyt Lab 1 — smoke and SCD",
    "description": "Запустите make run && make setup, затем Run collection. Запросы идут по порядку; они меняют пользователя, показание и установку счётчика. Для чистого повторения выполните make setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "realty_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "old_gauge_id",
      "value": "1"
    },
    {
      "key": "new_gauge_id",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "01 Основной сценарий",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Пустой ответ\", () => pm.expect(pm.response.text()).to.equal(\"\"));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Пример ответа после make setup",
              "status": "OK",
              "code": 200,
              "body": ""
            }
          ]
        },
        {
          "name": "Собственник: до изменений",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test(\"ID собственника\", () => pm.expect(Number(user.id) === Number(pm.collectionVariables.get(\"user_id\"))).to.be.true);",
                  "pm.test(\"Поля собственника\", () => [\"fio\",\"phone\",\"phone_prev\"].forEach(k => pm.expect(user).to.have.property(k)));",
                  "pm.collectionVariables.set(\"phone_before\", user.phone);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Пример ответа после make setup",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": 1,\n  \"fio\": \"Житель 1 Учебный\",\n  \"phone\": \"+79000000001\",\n  \"phone_prev\": \"\"\n}"
            }
          ]
        },
        {
          "name": "SCD 1: сменить ФИО",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fio\":\"Петрова Анна Сергеевна\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/users/{{user_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"Пустой ответ\", () => pm.expect(pm.response.text()).to.equal(\"\"));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Пример ответа после make setup",
              "status": "No Content",
              "code": 204,
              "body": ""
            }
          ]
        },
        {
          "name": "SCD 1: проверить ФИО",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}"

          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test(\"Новое ФИО\", () => pm.expect(user.fio === \"Петрова Анна Сергеевна\").to.be.true);",
                  "pm.test(\"Старого ФИО в ответе нет\", () => pm.expect(user.fio).not.to.equal(\"Житель 1 Учебный\"));"
